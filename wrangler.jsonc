{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greglinscheid-com",
  "compatibility_date": "2026-06-07",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {"pattern": "greglinscheid.com/*", "zone_name": "greglinscheid.com"},
    {"pattern": "www.greglinscheid.com/*", "zone_name": "greglinscheid.com"}
  ]
}
