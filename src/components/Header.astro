---
import Milo from './milo/Milo.astro';
import {
  header,
  headerSentinel,
  miloLink,
  nav,
  navLink,
  wordmark,
  wordmarkFull,
  wordmarkShort
} from '../styles/header.css';
---

<!-- The sentinel rides along so the header and the scroll depth that reveals it
live in one component. It anchors to the top of the document (absolute against
the initial containing block), which assumes Header renders near the top of body. -->
<div class={headerSentinel} data-header-sentinel aria-hidden="true"></div>

<header class={header} data-site-header data-stuck="false">
  <a class={miloLink} href="/milo/" aria-label="Meet Milo">
    <Milo size={40} />
  </a>
  <a class={wordmark} href="/">
    <span class={wordmarkFull}>Greg Linscheid</span>
    <span class={wordmarkShort}>Home</span>
  </a>
  <nav class={nav} aria-label="Site">
    <a class={navLink} href="/blog/">Blog</a>
    <a class={navLink} href="/tools/">Tools</a>
  </nav>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const sentinel = document.querySelector('[data-header-sentinel]');

  if (header instanceof HTMLElement && sentinel) {
    // The sentinel leaving the viewport means the page has scrolled past the
    // threshold, so the header should slide in.
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        header.dataset.stuck = entry.isIntersecting ? 'false' : 'true';
      }
    });

    observer.observe(sentinel);

    /*
     * Mobile browsers collapse their toolbar during downward touch scrolls and
     * leave the visual viewport offset below the layout viewport until the
     * gesture settles (or the toolbar returns). `position: fixed; top: 0`
     * anchors to the layout viewport, so without this the header's top slice
     * rides up off screen while scrolling down. Pinning `top` to the visual
     * viewport's offset keeps the whole bar visible; on desktop the offset is
     * always 0 and this never fires.
     */
    const {visualViewport} = window;
    if (visualViewport) {
      const align = () => {
        header.style.top = `${visualViewport.offsetTop}px`;
      };

      visualViewport.addEventListener('resize', align, {passive: true});
      visualViewport.addEventListener('scroll', align, {passive: true});
    }
  }
</script>
