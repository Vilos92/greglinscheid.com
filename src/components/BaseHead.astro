---
import '../styles/code.css.ts';
import '../styles/global.css.ts';
import {siteTitle} from '../site';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  keywords?: string;
  jsonLd?: Record<string, unknown>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {title, description, image, imageAlt = siteTitle, keywords, jsonLd} = Astro.props;

// No fallback image: a page that wants a social card passes a real one.
const imageURL = image === undefined ? undefined : new URL(image, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />

<!-- Cross-document view transitions: same-origin navigations crossfade, and the
elements sharing a view-transition-name (the header Milo and the /milo Milo) morph
between pages. An at-rule plus pseudo-elements, so it lives here as a global style
block rather than in vanilla-extract, which cannot emit @view-transition. Browsers
without cross-document support (Firefox, mid-2026) simply navigate instantly. -->
<style is:global>
  @view-transition {
    navigation: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>

<!-- The at-rule above opts the whole site in (both pages of a navigation must),
but the crossfade is only wanted around the Milo morph, so every other navigation
skips its transition. The outgoing page is the primary gate — it always knows both
URLs; the incoming page adds the same check where the Navigation API exists (its
referrer is useless on back navigations). Inline so it registers before the first
render opportunity, which is when pagereveal fires. -->
<script is:inline>
  const MILO_PATH = '/milo/';
  const involvesMilo = (a, b) => a === MILO_PATH || b === MILO_PATH;

  addEventListener('pageswap', event => {
    if (!event.viewTransition) {
      return;
    }

    const to = event.activation ? new URL(event.activation.entry.url).pathname : null;
    if (to === null || !involvesMilo(location.pathname, to)) {
      event.viewTransition.skipTransition();
    }
  });

  addEventListener('pagereveal', event => {
    const from = window.navigation?.activation?.from?.url;
    if (!event.viewTransition || from === undefined) {
      return;
    }

    if (!involvesMilo(new URL(from).pathname, location.pathname)) {
      event.viewTransition.skipTransition();
    }
  });
</script>
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />

<link rel="preconnect" href="https://fonts.bunny.net" />
<link
  href="https://fonts.bunny.net/css?family=fraunces:opsz,wght@9..144,600;9..144,700|source-sans-3:400,600,700"
  rel="stylesheet"
/>

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={siteTitle} />
<meta name="robots" content="index, follow" />
{keywords ? <meta name="keywords" content={keywords} /> : undefined}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{imageURL ? <meta property="og:image" content={imageURL} /> : undefined}
{imageURL ? <meta property="og:image:alt" content={imageAlt} /> : undefined}

<meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageURL ? <meta name="twitter:image" content={imageURL} /> : undefined}
{imageURL ? <meta name="twitter:image:alt" content={imageAlt} /> : undefined}

{
  jsonLd ? (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  ) : undefined
}
