---
import '../styles/code.css.ts';
import '../styles/global.css.ts';
import {siteTitle} from '../site';
import {palette} from '../styles/tokens';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  keywords?: string;
  jsonLd?: Record<string, unknown>;
}

// Social card for pages that do not supply their own. Only blog posts (their hero)
// and the 3D-to-SVG tool have a real card, so without a fallback every other page
// shares as a bare text blob. Milo is the site's mark, so he stands in.
const FALLBACK_IMAGE = '/og/default.png';
const FALLBACK_IMAGE_ALT = 'Milo, the site mascot, a grey and white cat';

/** Blank front matter reaches these props as an empty string, which means absent. */
function readText(value: string | undefined) {
  const trimmed = value?.trim();
  return trimmed === '' ? undefined : trimmed;
}

/**
 * A card no client can draw is the same as no card. Blog heroes are free-form paths
 * and at least one is an SVG, which none of the major social platforms render, so it
 * has to fall through to the fallback rather than ship an unrenderable preview.
 */
function readCardImage(value: string | undefined) {
  const path = readText(value);
  if (path === undefined) {
    return undefined;
  }
  // Read the extension off the bare path. A cache-busted hero like `/blog/x.svg?v=2`
  // is still an SVG, and checking the raw string would sail straight past it.
  const bare = path.replace(/[?#].*$/, '');
  return bare.toLowerCase().endsWith('.svg') ? undefined : path;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {title, description, image, imageAlt, keywords, jsonLd} = Astro.props;

const cardImage = readCardImage(image);
const imageURL = new URL(cardImage ?? FALLBACK_IMAGE, Astro.site);
// The alt has to follow the image that actually won. A page can pass an alt with no
// usable image of its own, and describing Milo with that page's words would be wrong.
const resolvedImageAlt =
  cardImage === undefined ? FALLBACK_IMAGE_ALT : (readText(imageAlt) ?? siteTitle);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light dark" />

<!-- Cross-document view transitions: same-origin navigations crossfade, and the
elements sharing a `view-transition-name` (the header Milo and the /milo Milo) morph
between pages. An at-rule plus pseudo-elements, so it lives here as a global style
block rather than in vanilla-extract, which cannot emit `@view-transition`. Browsers
without cross-document support (Firefox, mid-2026) simply navigate instantly. -->
<style is:global>
  @view-transition {
    navigation: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation: none !important;
    }
  }
</style>

<!-- The at-rule above opts the whole site in (both pages of a navigation must),
but the crossfade is only wanted around the Milo morph, so every other navigation
skips its transition. The outgoing page is the primary gate because it always
knows both URLs. The incoming page adds the same check where the Navigation API
exists, since its referrer is useless on back navigations. Inline so it registers
before the first render opportunity, which is when `pagereveal` fires. -->
<script is:inline>
  const MILO_PATH = '/milo/';
  const checkInvolvesMilo = (a, b) => a === MILO_PATH || b === MILO_PATH;

  addEventListener('pageswap', event => {
    if (!event.viewTransition) {
      return;
    }

    const to = event.activation ? new URL(event.activation.entry.url).pathname : null;
    if (to === null || !checkInvolvesMilo(location.pathname, to)) {
      event.viewTransition.skipTransition();
    }
  });

  addEventListener('pagereveal', event => {
    const from = window.navigation?.activation?.from?.url;
    if (!event.viewTransition || from === undefined) {
      return;
    }

    if (!checkInvolvesMilo(new URL(from).pathname, location.pathname)) {
      event.viewTransition.skipTransition();
    }
  });
</script>
<!-- Milo, as the site mark. Safari still does not read SVG favicons, so the ICO is a
live path for real traffic rather than a legacy fallback. Giving the ICO a concrete
`sizes` and the SVG none is what keeps Chrome from downloading both. The older advice
of `sizes="any"` does the opposite and makes it fetch each of them. -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Both need an explicit `prefers-color-scheme`, because a browser takes the first
tag that matches and an unconditional one would shadow the dark variant. The manifest
carries the same light value for installed windows, which cannot vary by scheme. -->
<meta name="theme-color" content={palette.pageBg} media="(prefers-color-scheme: light)" />
<meta name="theme-color" content={palette.pageBgDark} media="(prefers-color-scheme: dark)" />

<meta name="generator" content={Astro.generator} />

<link rel="preconnect" href="https://fonts.bunny.net" />
<link
  href="https://fonts.bunny.net/css?family=fraunces:opsz,wght@9..144,600;9..144,700|source-sans-3:400,600,700"
  rel="stylesheet"
/>

<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={siteTitle} />
<meta name="robots" content="index, follow" />
{keywords ? <meta name="keywords" content={keywords} /> : undefined}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteTitle} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={resolvedImageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={resolvedImageAlt} />

{
  jsonLd ? (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  ) : undefined
}
