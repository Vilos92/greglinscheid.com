---
import BaseLayout from '../../components/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import {formatTitle} from '../../site';

const pageDescription =
  "A collection of web-based tools I've made. 3D to SVG turns a 3D model into an SVG icon.";
---

<BaseLayout
  title={formatTitle('Tools')}
  description={pageDescription}
  keywords="browser tools, web tools, SVG tools, 3D to SVG, GLB to SVG"
>
  <Prose>
    <h1>Tools</h1>

    <p>A collection of web-based tools I've made.</p>

    <ul>
      <li>
        <a href="/tools/3d-to-svg/">3D to SVG</a> turns a 3D model into an SVG icon.
      </li>
    </ul>
  </Prose>
</BaseLayout>
